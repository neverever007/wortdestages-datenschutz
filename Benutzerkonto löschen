<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Konto löschen – Wort des Tages</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      max-width: 600px;
      margin: 60px auto;
      padding: 0 24px;
      color: #1F1A14;
      background: #FAF7F0;
      line-height: 1.7;
    }
    h1 { font-size: 28px; margin-bottom: 8px; }
    p { margin: 16px 0; }
    ol { padding-left: 24px; }
    li { margin: 10px 0; }
    .note {
      background: #fff;
      border-left: 4px solid #B5502E;
      padding: 14px 18px;
      margin: 28px 0;
      border-radius: 0 8px 8px 0;
    }
    a { color: #B5502E; }
  </style>
